# Copy this file to ".env.local" for local use, or add each line in Vercel → Settings → Environment Variables.
# Never commit real values.

# --- Access (passphrase gate) ---
CRUMB_PASSPHRASE=choose-a-long-memorable-phrase
# A long random string. Generate one at https://generate-secret.vercel.app/32
CRUMB_SESSION_SECRET=

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" secret key. Server-only. Never put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=
# Optional: override the model
# CRUMB_AI_MODEL=claude-sonnet-5-5

# --- Optional: Instagram fetcher (apify.com → Settings → Integrations → API token) ---
# Leave empty to use only the free page-preview method + screenshots.
APIFY_TOKEN=

# --- Video reading (aistudio.google.com → Get API key) ---
# Lets Crumb "watch" Reels when the recipe is spoken or shown on screen rather than written in the caption.
GEMINI_API_KEY=
# Optional: override the video model
# GEMINI_MODEL=gemini-2.5-flash
