{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["src", "components", "lib", "globals.d.ts"]
}
